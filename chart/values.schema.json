{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plutus-collector values",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusterName", "currency"],
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "description": "Required. Labels every pushed row and is OpenCost's cluster id, e.g. prod-us-east-1."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Required. ISO 4217 code OpenCost is priced in, e.g. USD. Never defaulted."
    },
    "apiKey": { "type": "string" },
    "existingSecret": { "type": "string" },
    "existingSecretKey": { "type": "string", "minLength": 1 },
    "plutusIngestUrl": { "type": "string", "pattern": "^https://" },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": { "type": "array", "items": { "type": "object" } }
      }
    },
    "pusher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/podImage" },
        "ingestCA": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utcTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "jitterMinutes": { "type": "integer", "minimum": 0, "maximum": 180 }
          }
        },
        "catchUpDays": { "type": "integer", "minimum": 1, "maximum": 14 },
        "emptyResult": { "type": "string", "enum": ["fail", "ignore"] },
        "pushIntervalMinutes": { "type": ["integer", "null"], "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "blockPushOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prometheus_reachable", "opencost_series", "allocation_series", "pods_running",
              "pod_labels", "namespace_labels", "controller_labels", "usage_series",
              "cluster_ambiguity", "history", "opencost_reachable", "allocation_nonempty", "pricing"
            ]
          }
        },
        "helmTest": { "type": "boolean" }
      }
    },
    "opencost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "image": { "$ref": "#/definitions/registryImage" },
        "resources": { "type": "object" },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "enum": ["auto", "custom"] },
            "custom": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "CPU": { "$ref": "#/definitions/rate" },
                "RAM": { "$ref": "#/definitions/rate" },
                "GPU": { "$ref": "#/definitions/rate" },
                "storage": { "$ref": "#/definitions/rate" },
                "spotCPU": { "$ref": "#/definitions/rate" },
                "spotRAM": { "$ref": "#/definitions/rate" },
                "zoneNetworkEgress": { "$ref": "#/definitions/rate" },
                "regionNetworkEgress": { "$ref": "#/definitions/rate" },
                "internetNetworkEgress": { "$ref": "#/definitions/rate" }
              }
            }
          }
        },
        "queryResolutionSeconds": { "type": "integer", "minimum": 60 },
        "ui": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "const": false, "description": "The OpenCost UI is not part of this chart." } } },
        "mcp": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "const": false, "description": "The OpenCost MCP server is not part of this chart." } } },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "extraContainers": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "securityContext": { "type": "object" },
        "opencost": { "type": "object", "description": "v1 passthrough values; translated by the chart, see MIGRATING.md." }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["bundled", "external", "none"] },
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "$ref": "#/definitions/registryImage" },
            "scrapeInterval": { "type": "string", "pattern": "^[0-9]+(s|m)$" },
            "retention": { "type": "string", "pattern": "^[0-9]+(d|h)$" },
            "storage": { "$ref": "#/definitions/storage" },
            "scrapeCadvisor": { "type": "boolean" },
            "scrapeKubeletVolumeStats": { "type": "boolean" },
            "resources": { "type": "object" },
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object" }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^(https?://[^/@?#]+([/?#].*)?)?$", "description": "Query API base. Credentials do not belong in the URL." },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["none", "basic", "bearer", "mtls"] },
                "existingSecret": { "type": "string" },
                "usernameKey": { "type": "string" },
                "passwordKey": { "type": "string" },
                "tokenKey": { "type": "string" },
                "caKey": { "type": "string" },
                "certKey": { "type": "string" },
                "keyKey": { "type": "string" }
              }
            },
            "tenantId": { "type": "string" },
            "insecureSkipVerify": { "type": "boolean" },
            "clusterLabel": { "type": "string", "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$" },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "labels": { "type": "object" }
              }
            }
          }
        },
        "none": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acknowledgeNodesProxy": { "type": "boolean" },
            "scrapeInterval": { "type": "string", "pattern": "^[0-9]+(s|m)$" },
            "storage": { "$ref": "#/definitions/storage" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "none": {
                "properties": { "acknowledgeNodesProxy": { "const": true } },
                "required": ["acknowledgeNodesProxy"]
              }
            },
            "required": ["none"]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "external" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "external": {
                "properties": { "url": { "type": "string", "minLength": 1 } },
                "required": ["url"]
              }
            },
            "required": ["external"]
          }
        }
      ]
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "securityContext": { "type": "object" },
    "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "pushIntervalMinutes": { "type": ["integer", "null"], "minimum": 1, "description": "Deprecated v1 key." },
    "imagePullSecrets": { "type": "array", "description": "Deprecated v1 key; use global.imagePullSecrets." },
    "image": { "type": "object", "description": "Deprecated v1 key; use pusher.image." },
    "resources": { "type": "object", "description": "Deprecated v1 key; use pusher.resources." }
  },
  "definitions": {
    "rate": {
      "type": ["string", "number"],
      "description": "A price per hour (per GB-hour for RAM and storage). Quoted or not."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["emptyDir", "pvc"] },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
        "storageClass": { "type": "string" }
      }
    },
    "podImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "registryImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
